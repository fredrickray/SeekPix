# Paths (relative to project root unless absolute)
SEEKPIX_DATA_DIR=data
SEEKPIX_PHOTOS_DIR=data/photos
SEEKPIX_THUMBNAILS_DIR=data/thumbnails
SEEKPIX_INDEXES_DIR=data/indexes
SEEKPIX_DB_PATH=data/metadata.db

# CLIP
SEEKPIX_CLIP_MODEL=ViT-B-32
SEEKPIX_CLIP_PRETRAINED=openai
SEEKPIX_CLIP_DEVICE=cpu

# Face matching
SEEKPIX_FACE_DET_SIZE=640
SEEKPIX_FACE_MATCH_THRESHOLD=0.40
SEEKPIX_FACE_DEVICE=cpu

# Thumbnails
SEEKPIX_THUMB_SIZE=256

# API (for SeekPix UI)
SEEKPIX_API_HOST=0.0.0.0
SEEKPIX_API_PORT=8000
